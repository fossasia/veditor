# Copy to deployment/.env and replace every example secret before starting.
POSTGRES_USER=veditor
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=veditor

# Generate a secure 32-byte secret using: openssl rand -hex 32
# Must be at least 32 bytes and must not use placeholder values.
SESSION_SECRET=replace-this-secret
ENVIRONMENT=production
BASE_URL=https://veditor.example.org

# Optional email delivery settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=True
# SMTP_SSL=False
# SMTP_FROM=VEditor <noreply@example.org>

# Optional host port for the API.
API_PORT=8000

# Optional Docker registry credentials for Watchtower if the image repository is private.
# REPO_USER=
# REPO_PASS=

# WARNING: When reusing existing volume names, always stop the old stack
# before starting this one. Concurrent access by two stacks will corrupt data.
# Keep these names aligned with existing root-Compose volumes when migrating.
# Use unique names for an isolated test stack.
POSTGRES_VOLUME_NAME=veditor_postgres_data
REDIS_VOLUME_NAME=veditor_redis_data
DATA_VOLUME_NAME=veditor_veditor_data
INGEST_VOLUME_NAME=veditor_veditor_ingest
