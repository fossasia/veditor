<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}VEditor{% endblock %} — Production Console</title>
  <meta name="description" content="VEditor — Automated conference video processing pipeline">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/theme.css">
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/theme.js"></script>
  {% block extra_head %}{% endblock %}
</head>
<body class="{% if request.url.path == '/studio' or request.url.path.startswith('/studio/') %}is-studio-mode{% endif %}{% if (not user or user.role not in ['organizer', 'admin']) and request.url.path.startswith('/studio/talks/') %} is-speaker{% endif %}">
<div class="app-shell">

  <!-- ── Full-Width Fixed Topbar ──────────────────────────────── -->
  <header class="topbar" id="app-topbar">
    <div class="topbar-left">
      <button type="button" class="btn btn-ghost btn-sm sidebar-toggle-btn" id="sidebar-toggle-btn" title="Toggle sidebar" aria-label="Toggle sidebar" aria-expanded="true" aria-controls="app-sidebar">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <a href="/studio" class="topbar-brand" id="topbar-brand-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <span class="logo-text" id="app-logo-text">VEditor</span>
      </a>
      <div class="breadcrumb">
        {% block breadcrumb %}
          <span class="current">Talks Dashboard</span>
        {% endblock %}
      </div>
    </div>

    <div class="topbar-actions">
      {% block topbar_actions %}{% endblock %}

      <div class="topbar-control-group">
        <!-- Dynamic Authentication State -->
        {% if user %}
          <span class="user-email">{{ user.email or user.display_name or (('SSO (' ~ user.role | capitalize ~ ')') if user.is_sso else (user.role | capitalize)) }}</span>
          <span class="badge badge-role badge-{{ user.role }}">{{ user.role | capitalize }}</span>
          <details class="user-menu-wrapper" id="user-menu-wrapper">
            <summary class="user-bubble-btn" id="user-menu-btn" title="User menu" aria-label="User menu" aria-expanded="false" aria-controls="user-dropdown-menu">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </summary>
            <div class="user-dropdown" id="user-dropdown-menu">
              <div class="user-dropdown-header">
                <span class="user-dropdown-label">Signed in as</span>
                {% if user.email %}
                  <span class="user-email" title="{{ user.email }}">{{ user.email }}</span>
                {% elif user.display_name %}
                  <span class="user-email" title="{{ user.display_name }}">{{ user.display_name }}</span>
                {% elif user.is_sso %}
                  <span class="user-email">SSO ({{ user.role | capitalize }})</span>
                {% else %}
                  <span class="user-email">{{ user.role | capitalize }}</span>
                {% endif %}
              </div>
              <div class="user-dropdown-divider"></div>
              <button type="button" class="user-dropdown-item" id="theme-toggle-btn">
                <svg id="theme-icon-sun" class="theme-icon-hidden" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
                <svg id="theme-icon-moon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <span id="theme-toggle-label">Dark Mode</span>
              </button>
              <div class="user-dropdown-divider"></div>
              {% if user.role == 'admin' %}
              <a href="/admin" class="user-dropdown-item" id="admin-console-btn">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                <span>Admin Console</span>
              </a>
              {% endif %}
              <form method="post" action="/logout" class="logout-form">
                <button type="submit" class="user-dropdown-item logout-item" id="logout-btn">
                  <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                  </svg>
                  <span>Log out</span>
                </button>
              </form>
            </div>
          </details>
        {% else %}
          <a href="/login" class="btn btn-ghost btn-sm" id="login-link">Log in</a>
          <a href="/signup" class="btn btn-primary btn-sm" id="signup-link">Sign up</a>
          <button class="btn btn-ghost btn-sm" id="theme-toggle-btn" title="Toggle Theme">
            <svg id="theme-icon-sun" class="theme-icon-hidden" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <svg id="theme-icon-moon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- ── Sidebar ─────────────────────────────────────────────── -->
  {% block sidebar %}
  <aside class="sidebar" id="app-sidebar" aria-label="Sidebar navigation">
    <div class="sidebar-header">
      <span class="nav-label">Workspace</span>
      <button type="button" class="btn btn-ghost btn-sm sidebar-collapse-btn" id="sidebar-collapse-btn" title="Collapse sidebar" aria-label="Collapse sidebar" aria-expanded="true" aria-controls="app-sidebar">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
    </div>
    <nav class="sidebar-nav" id="sidebar-nav">
      {% if user and user.role in ['organizer', 'admin'] and not user.is_sso %}
      <a href="/studio/events" class="nav-item {% if '/events' in request.url.path %}active{% endif %}" id="nav-events-link">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Events
      </a>
      {% endif %}
      <a href="/studio" class="nav-item {% if request.url.path == '/studio' %}active{% endif %}" id="nav-talks-link">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="7"/>
          <rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/>
        </svg>
        Talks
      </a>
    </nav>
  </aside>
  {% endblock %}

  <!-- ── Main Content ─────────────────────────────────────────── -->
  <main class="main-content">
    {% block content %}{% endblock %}
  </main>
</div>

{% block extra_scripts %}{% endblock %}
</body>
</html>
