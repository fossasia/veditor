{% extends "base.html.jinja" %}
{% block title %}{{ talk.title[:40] }}{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/static/css/studio.css">
{% endblock %}

{% macro status_badge(status) %}
  {% if status == 'waiting_for_files' %}
    <span class="badge badge-waiting"><span class="badge-dot"></span>Waiting for files</span>
  {% elif status == 'detecting' %}
    <span class="badge badge-processing"><span class="spinner spinner-sm"></span>Detecting</span>
  {% elif status in ['pending_approval', 'pending_bounds'] %}
    <span class="badge badge-pending"><span class="badge-dot"></span>Pending Review</span>
  {% elif status == 'pending_intro_outro' %}
    <span class="badge badge-pending"><span class="badge-dot"></span>Pending Bumpers</span>
  {% elif status in ['cutting', 'generating_previews', 'assembling', 'transcoding', 'uploading'] %}
    <span class="badge badge-processing"><span class="spinner spinner-sm"></span>{{ status | replace('_', ' ') | title }}</span>
  {% elif status == 'preview' %}
    <span class="badge badge-preview"><span class="badge-dot"></span>Preview Ready</span>
  {% elif status == 'needs_work' %}
    <span class="badge badge-pending"><span class="badge-dot"></span>Needs Work</span>
  {% elif status == 'done' %}
    <span class="badge badge-done"><span class="badge-dot"></span>Published</span>
  {% elif status in ['rejected', 'broken'] %}
    <span class="badge badge-danger"><span class="badge-dot"></span>{{ status | title }}</span>
  {% else %}
    <span class="badge badge-waiting"><span class="badge-dot"></span>{{ status }}</span>
  {% endif %}
{% endmacro %}

{% block breadcrumb %}
  {% if is_from_admin %}
    <a href="/admin">Admin Console</a>
    <span class="sep">/</span>
    <a href="/admin/events">Events</a>
    <span class="sep">/</span>
    {% if talk.event_id %}
      <a href="/admin/events/{{ talk.event_id }}" class="breadcrumb-event">{{ talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) }}</a>
    {% else %}
      <span class="breadcrumb-event">{{ talk.event.name if talk.event and talk.event.name else 'Event' }}</span>
    {% endif %}
    {% if talk.room %}
      <span class="sep">/</span>
      <span class="breadcrumb-room">{{ talk.room }}</span>
    {% endif %}
    <span class="sep">/</span>
    <span class="current" title="{{ talk.title }}">{{ talk.title }}</span>
  {% else %}
    <a href="/studio" class="breadcrumb-back">&larr; Talks</a>
    <span class="sep">/</span>
    {% set event_label = talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) %}
    {% if talk.event_id is none or (user and user.is_sso and user.scope_type == 'talk') %}
      <span class="breadcrumb-event">{{ event_label }}</span>
      <span class="sep">/</span>
      <span class="breadcrumb-room">{{ talk.room or '—' }}</span>
    {% else %}
      <a href="/studio?event_id={{ talk.event_id }}" class="breadcrumb-event breadcrumb-link" id="breadcrumb-event-link">{{ event_label }}</a>
      <span class="sep">/</span>
      {% if talk.room %}
        <a href="/studio/rooms/{{ talk.room | urlencode }}?event_id={{ talk.event_id }}" class="breadcrumb-room breadcrumb-link" id="breadcrumb-room-link">{{ talk.room }}</a>
      {% else %}
        <span class="breadcrumb-room">—</span>
      {% endif %}
    {% endif %}
    <span class="sep">/</span>
    <span class="current" title="{{ talk.title }}">{{ talk.title }}</span>
  {% endif %}
  {% if (user and user.role in ['organizer', 'admin'] and not user.is_sso) or (user is none) %}
  <button class="btn btn-ghost btn-sm breadcrumb-edit-btn" id="btn-edit-talk-studio" title="Edit Talk">
    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
  </button>
  {% endif %}
{% endblock %}

{% block topbar_actions %}
  {% if talk.start %}
    {% set start_utc = talk.start.astimezone(UTC) if talk.start.tzinfo else talk.start %}
    {% if talk.end %}
      {% set end_utc = talk.end.astimezone(UTC) if talk.end.tzinfo else talk.end %}
      {% if start_utc.date() == end_utc.date() %}
        {% set time_str = start_utc.strftime('%b %d, %H:%M') ~ ' – ' ~ end_utc.strftime('%H:%M UTC') %}
      {% else %}
        {% set time_str = start_utc.strftime('%b %d, %H:%M UTC') ~ ' – ' ~ end_utc.strftime('%b %d, %H:%M UTC') %}
      {% endif %}
    {% else %}
      {% set time_str = start_utc.strftime('%b %d, %H:%M UTC') %}
    {% endif %}
    <span class="topbar-time-meta">{{ time_str }}{% if duration_seconds and duration_seconds > 0 %} ({{ duration_seconds | format_duration }}){% endif %}</span>
  {% endif %}
  {{ status_badge(talk.status) }}
{% endblock %}

{% block content %}
{% set can_manage = (user and user.role in ['organizer', 'admin'] and not user.is_sso) or (user is none) %}
{% set is_admin_or_org = (user and user.role in ['organizer', 'admin']) or (user is none) %}
{% set awaiting_speaker = talk.speaker_email and not is_speaker %}
<div class="studio-shell{% if is_other_organizer_talk %} is-view-only{% endif %}" data-talk-id="{{ talk.id }}" data-talk-status="{{ talk.status }}" data-cut-start="{{ talk.cut_start if talk.cut_start is not none else '' }}" data-cut-end="{{ talk.cut_end if talk.cut_end is not none else '' }}" data-talk-title="{{ (talk.title or '') | e }}" data-talk-room="{{ (talk.room or '') | e }}" data-talk-start="{{ talk.start.isoformat() if talk.start else '' }}" data-talk-end="{{ talk.end.isoformat() if talk.end else '' }}" data-preview-urls="{{ preview_urls | tojson | forceescape }}" data-is-other-organizer="{{ 'true' if is_other_organizer_talk else 'false' }}">

  <!-- ── CENTER: Video Player or Upload Dropzone ─────────────── -->
  <div class="player-panel">
    <button id="btn-expand-right-panel" class="btn btn-ghost btn-icon btn-sm expand-panel-tab" title="Restore Review Panel" aria-label="Restore Review Panel" aria-expanded="false" aria-controls="studio-panel-right">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>

    {% if is_other_organizer_talk %}
    <!-- Admin View-Only Warning Banner -->
    <div class="admin-view-only-banner" id="admin-view-only-banner">
      <div class="banner-info-group">
        <span class="badge badge-warning" id="banner-mode-badge">View Only</span>
        <span class="banner-text-desc" id="banner-mode-text" data-event-name="{{ talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) }}" data-default-text="Viewing another organizer's talk ({{ talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) }}). Editing and pipeline actions are locked.">
          Viewing another organizer's talk (<strong>{{ talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) }}</strong>). Editing and pipeline actions are locked.
        </span>
      </div>
      <div class="banner-actions-group">
        <a href="{{ back_url }}" class="btn btn-ghost btn-sm" id="btn-banner-back">
          &larr; Back to Event Talks
        </a>
        <button type="button" class="btn btn-warning btn-sm" id="btn-toggle-edit-mode">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 20h9"/>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          <span>Enable Edit Mode</span>
        </button>
      </div>
    </div>
    {% endif %}

    {% if talk.status == 'waiting_for_files' %}
    <!-- Upload Dropzone Box (Pending Upload State) -->
    <div class="upload-pending-container">
      <div class="upload-dropzone-box" id="no-preview-msg">
        <input type="file" id="video-file-input" data-edit-control="true" accept="video/mp4,video/mkv,video/webm,video/quicktime,video/*">
        <div class="upload-icon-circle">
          <svg class="upload-icon" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <span class="upload-prompt-title">
          Attach Recording Video
        </span>
        <span class="upload-prompt-subtitle">
          Drag & drop raw conference video file here, or click to browse.
        </span>
        <span class="upload-prompt-formats">
          Supports MP4, MKV, MOV, WebM
        </span>
        <button class="btn btn-primary btn-sm" id="btn-browse-file" data-edit-control="true" type="button">
          Browse Video File
        </button>
        <div id="upload-progress-wrap">
          <span class="spinner spinner-sm upload-spinner"></span>
          <span id="upload-progress-text">Uploading & validating video streams...</span>
        </div>
      </div>
    </div>
    {% else %}
    <!-- Video Viewport -->
    <div class="player-viewport">
      {% if talk.status == 'preview' and is_speaker %}
      <div class="preview-quality-notice" id="preview-quality-notice" role="note" aria-label="Preview quality notice">
        <svg class="preview-quality-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span class="preview-quality-text">
          <strong>Low-Quality Preview:</strong> This preview is generated for reviewing edits and timing. It does not reflect the final video quality.
        </span>
      </div>
      {% endif %}
      <video id="main-video" preload="metadata">
        Your browser does not support HTML5 video.
      </video>
      <div class="player-no-preview" id="no-preview-msg">
        <span>Video preview not available</span>
      </div>
    </div>

    <!-- Timecode & Jump Bar -->
    <div class="timecode-bar">
      <div class="player-time-group">
        <span class="timecode" id="timecode-display">00:00:00.00</span>
        <span id="duration-display">/ 00:00:00.00</span>
      </div>

      <div class="player-nav-group">
        <!-- Jump directly to timecode -->
        <div class="jump-time-wrap">
          <label for="jump-time-input" class="jump-time-label">Jump to:</label>
          <input type="text" id="jump-time-input" placeholder="MM:SS" class="input-field">
        </div>

        <div class="speed-select-wrap">
          <label for="speed-select" class="speed-select-label">Speed:</label>
          <select id="speed-select" class="select-field">
            <option value="0.25">0.25×</option>
            <option value="0.5">0.5×</option>
            <option value="1" selected>1×</option>
            <option value="1.5">1.5×</option>
            <option value="2">2×</option>
          </select>
        </div>

        <button class="ctrl-btn mute-btn" id="btn-mute" title="Mute / Unmute (M)" aria-label="Mute or unmute audio">
          <svg id="icon-volume-on" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          <svg id="icon-volume-muted" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        </button>

        {% if media_assets %}
        <div class="source-select-wrap" id="source-select-wrap">
          <label for="media-source-select" class="source-select-label">Source:</label>
          <select id="media-source-select" class="select-field" aria-label="Select video source">
            {% for asset in media_assets %}
              {% if asset.category in ['final', 'preview', 'raw'] %}
                <option value="{{ asset.url }}" data-category="{{ asset.category }}">{{ asset.label }}</option>
              {% endif %}
            {% endfor %}
          </select>
          <a id="media-download-btn" href="#" target="_blank" class="btn btn-ghost btn-sm media-download-btn" title="Download video" download aria-label="Download video">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download</span>
          </a>
        </div>
        {% endif %}
      </div>
    </div>

    <!-- Coarse, Fine & Big Seek Controls -->
    <div class="player-controls">
      <button class="ctrl-btn" id="btn-seek-mega-back" title="Rewind 5 minutes (-5m)">-5m</button>
      <button class="ctrl-btn" id="btn-seek-big-back" title="Rewind 1 minute (-1m)">-1m</button>
      <button class="ctrl-btn" id="btn-skip-back" title="Back 5s (-5s)">-5s</button>
      <button class="ctrl-btn" id="btn-prev-frame" title="Rewind 0.5s (-0.5s)">-0.5s</button>

      <!-- Play / Pause -->
      <button class="ctrl-btn play-btn" id="btn-play" title="Play / Pause (Space)">
        <svg id="icon-play" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21"/></svg>
        <svg id="icon-pause" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      </button>

      <!-- Fine, Big & Mega Seek Forward -->
      <button class="ctrl-btn" id="btn-next-frame" title="Forward 0.5s (+0.5s)">+0.5s</button>
      <button class="ctrl-btn" id="btn-skip-fwd" title="Forward 5s (+5s)">+5s</button>
      <button class="ctrl-btn" id="btn-seek-big-fwd" title="Forward 1 minute (+1m)">+1m</button>
      <button class="ctrl-btn" id="btn-seek-mega-fwd" title="Forward 5 minutes (+5m)">+5m</button>
    </div>

    <!-- Timeline & Cut Bounds -->
    <div class="timeline-section">
      <div class="timeline-label">
        <span>Timeline</span>
        <span id="tl-range-label"></span>
      </div>

      <div class="timeline-track" id="timeline-track">
        <canvas id="tl-waveform" class="tl-waveform" aria-hidden="true"></canvas>
        {% if talk.status in ['pending_bounds', 'needs_work'] and not awaiting_speaker %}
        <div class="tl-block tl-content" id="tl-content"></div>
        <div class="tl-marker" id="tl-start-marker" title="Drag Start Point (or press I)"></div>
        <div class="tl-marker end-marker" id="tl-end-marker" title="Drag End Point (or press O)"></div>
        {% endif %}
        <div id="tl-playhead"></div>
      </div>

      <div class="timeline-ticks" id="timeline-ticks">
        <span class="tl-tick">00:00:00</span>
        <span class="tl-tick">—</span>
        <span class="tl-tick">—</span>
        <span class="tl-tick">—</span>
        <span class="tl-tick">—</span>
      </div>

      {% if talk.status in ['pending_bounds', 'needs_work'] and not awaiting_speaker %}
      <!-- In/Out Bounds Setting Controls -->
      <div class="timeline-inputs-bar">
        <div class="bounds-inputs-group">
          <div class="bounds-input-pair">
            <button class="btn btn-success btn-sm" id="btn-set-in" data-edit-control="true" title="Set In-Point (I)">
              Set In (I)
            </button>
            <input type="text" id="input-in-point" data-edit-control="true" value="00:00:00.00" class="input-field bounds-time-input">
          </div>

          <span class="bounds-to-label">to</span>

          <div class="bounds-input-pair">
            <input type="text" id="input-out-point" data-edit-control="true" value="00:00:00.00" class="input-field bounds-time-input">
            <button class="btn btn-danger btn-sm" id="btn-set-out" data-edit-control="true" title="Set Out-Point (O)">
              Set Out (O)
            </button>
          </div>
        </div>

        <div class="bounds-action-btns">
          <span class="badge badge-info bounds-duration-badge" id="cut-duration-badge">Selected Cut: 0s</span>
          <button class="btn btn-ghost btn-sm" id="btn-play-cut" data-edit-control="true" title="Play trimmed range">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21"/></svg>
            Play Cut Range
          </button>
        </div>
      </div>
      {% endif %}
    </div>
    {% endif %}

  </div>

  <!-- ── RIGHT: 4 Milestones & Review Actions ────────────────── -->
  <div class="studio-panel" id="studio-panel-right">
    <div class="studio-panel-header">
      <div class="studio-panel-header-title-wrap">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span class="studio-panel-title">Workflow & Review</span>
      </div>
      <button id="btn-toggle-right-panel" class="btn btn-ghost btn-icon btn-sm" title="Collapse Review Panel" aria-label="Collapse Review Panel" aria-expanded="true" aria-controls="studio-panel-right">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>
    <div class="studio-panel-body">

      <!-- Action Panel for Review Actions -->
      <div class="review-box">
        <div class="review-box-title">
          Review Actions
        </div>

        {% if talk.status in ['pending_bounds', 'preview', 'needs_work'] and not awaiting_speaker %}
        <div class="review-notes-wrap">
          <label for="review-notes-input" class="review-notes-label">Reviewer Notes</label>
          <textarea id="review-notes-input" data-edit-control="true" class="input-field" rows="2" placeholder="Optional note for organizer"></textarea>
        </div>
        {% endif %}

        {% if talk.status in ['pending_bounds', 'needs_work'] and not awaiting_speaker %}
        <div class="submission-timestamps-card" id="submission-timestamps-card">
          <div class="submission-timestamps-header">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="submission-timestamps-title">Timestamps to Submit</span>
          </div>
          <div class="submission-timestamps-body">
            <div class="timestamp-range-pill">
              <div class="timestamp-unit">
                <span class="timestamp-label">Start (In)</span>
                <span class="timestamp-val" id="review-in-point">{{ talk.cut_start | timecode }}</span>
              </div>
              <span class="timestamp-arrow">→</span>
              <div class="timestamp-unit">
                <span class="timestamp-label">End (Out)</span>
                <span class="timestamp-val" id="review-out-point">{{ talk.cut_end | timecode }}</span>
              </div>
            </div>
            <div class="timestamp-duration-text">
              <span>Cut Duration:</span>
              <strong id="review-duration">{% if talk.cut_start is not none and talk.cut_end is not none %}{{ (talk.cut_end - talk.cut_start) | timecode }}{% else %}00:00:00.00{% endif %}</strong>
            </div>
          </div>
        </div>
        {% endif %}

        <div class="action-btns" id="action-btns">
          {% if talk.status == 'waiting_for_files' %}
            <div class="badge badge-waiting badge-status-full">
              Status: Awaiting Recording Upload (Drop file in player)
            </div>

          {% elif talk.status in ['detecting', 'cutting', 'generating_previews', 'assembling', 'transcoding', 'uploading'] %}
            <div class="badge badge-processing badge-status-full">
              <span class="spinner spinner-sm"></span> Processing in background ({{ talk.status | replace('_', ' ') | title }})...
            </div>
          {% elif talk.status == 'pending_approval' %}
            <button class="btn btn-success w-full" id="btn-approve" data-edit-control="true">
              Approve Raw Video
            </button>
            <button class="btn btn-danger w-full btn-reject-spacing" id="btn-reject" data-edit-control="true">
              Reject Raw Video
            </button>
          {% elif talk.status == 'pending_bounds' %}
            {% if awaiting_speaker %}
              <div class="badge badge-waiting badge-status-full">
                Awaiting Speaker to Submit Timestamps
              </div>
            {% else %}
              <button class="btn btn-primary w-full" id="btn-approve" data-edit-control="true">
                Submit Timestamps
              </button>
            {% endif %}
            {% if is_admin_or_org %}
              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-abort" data-edit-control="true">
                Abort Talk
              </button>
            {% endif %}
          {% elif talk.status == 'needs_work' %}
            {% if awaiting_speaker %}
              <div class="badge badge-waiting badge-status-full">
                Awaiting Speaker to Submit Revised Timestamps
              </div>
            {% else %}
              <button class="btn btn-primary w-full" id="btn-approve" data-edit-control="true">
                Submit Timestamps
              </button>
            {% endif %}
            {% if is_admin_or_org %}
              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-abort" data-edit-control="true">
                Abort Talk
              </button>
            {% endif %}
          {% elif talk.status == 'preview' %}
            {% if awaiting_speaker %}
              <div class="badge badge-waiting badge-status-full">
                Awaiting Speaker to Review Preview
              </div>
            {% else %}
              <button class="btn btn-success w-full" id="btn-approve" data-edit-control="true">
                Approve Preview
              </button>
              <button class="btn btn-warning w-full" id="btn-needs-work" data-edit-control="true">
                Request Changes (Needs Work)
              </button>
              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-reject" data-edit-control="true">
                Reset Talk to Raw
              </button>
            {% endif %}
            {% if is_admin_or_org %}
              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-abort" data-edit-control="true">
                Abort Talk
              </button>
            {% endif %}
          {% elif talk.status == 'pending_intro_outro' %}
            {% if is_admin_or_org and not is_speaker %}
              <div class="bumper-studio-card" id="card-bumper-options">
                <div class="bumper-studio-title">EVENT BRANDING & BUMPERS</div>

                <!-- Opening Intro -->
                <div class="bumper-group">
                  <div class="bumper-group-header">
                    <span class="bumper-group-title">Opening Intro</span>
                    <label class="bumper-toggle-label" for="check-include-intro" title="Enable Opening Intro">
                      <input type="checkbox" id="check-include-intro" class="toggle-checkbox" {% if talk.include_intro %}checked{% endif %}>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="bumper-nested-options {% if not talk.include_intro %}is-hidden{% endif %}" id="intro-options-wrap">
                    <div class="bumper-segmented-control">
                      <label class="bumper-segment {% if talk.intro_source != 'custom' %}is-active{% endif %}">
                        <input type="radio" name="intro_source" value="generated" class="bumper-radio-input" {% if talk.intro_source != 'custom' %}checked{% endif %}>
                        <span>Generated Title</span>
                      </label>
                      <label class="bumper-segment {% if talk.intro_source == 'custom' %}is-active{% endif %}">
                        <input type="radio" name="intro_source" value="custom" class="bumper-radio-input" {% if talk.intro_source == 'custom' %}checked{% endif %}>
                        <span>Custom Video</span>
                      </label>
                    </div>

                    <div class="bumper-custom-wrap {% if talk.intro_source == 'custom' %}is-visible{% endif %}" id="intro-custom-wrap">
                      <label for="custom-intro-file" class="bumper-dropzone" id="intro-dropzone" title="Click or drag & drop custom intro clip">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                          <polyline points="17 8 12 3 7 8"/>
                          <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <div class="bumper-dropzone-text">
                          <span class="bumper-dropzone-title">Drop video here or <u>browse</u></span>
                          <span class="bumper-file-name" id="intro-file-name">{% if talk.custom_intro_path %}{{ talk.custom_intro_path.split('/')[-1] }}{% else %}Supports MP4, WebM, MOV{% endif %}</span>
                        </div>
                      </label>
                      <input type="file" id="custom-intro-file" class="custom-bumper-file-input" accept="video/mp4,video/*">
                      <input type="hidden" id="custom-intro-path" value="{{ talk.custom_intro_path or '' }}">
                    </div>
                  </div>
                </div>

                <!-- Closing Outro -->
                <div class="bumper-group">
                  <div class="bumper-group-header">
                    <span class="bumper-group-title">Closing Outro</span>
                    <label class="bumper-toggle-label" for="check-include-outro" title="Enable Closing Outro">
                      <input type="checkbox" id="check-include-outro" class="toggle-checkbox" {% if talk.include_outro %}checked{% endif %}>
                      <span class="toggle-slider"></span>
                    </label>
                  </div>

                  <div class="bumper-nested-options {% if not talk.include_outro %}is-hidden{% endif %}" id="outro-options-wrap">
                    <div class="bumper-segmented-control">
                      <label class="bumper-segment {% if talk.outro_source != 'custom' %}is-active{% endif %}">
                        <input type="radio" name="outro_source" value="generated" class="bumper-radio-input" {% if talk.outro_source != 'custom' %}checked{% endif %}>
                        <span>Generated Title</span>
                      </label>
                      <label class="bumper-segment {% if talk.outro_source == 'custom' %}is-active{% endif %}">
                        <input type="radio" name="outro_source" value="custom" class="bumper-radio-input" {% if talk.outro_source == 'custom' %}checked{% endif %}>
                        <span>Custom Video</span>
                      </label>
                    </div>

                    <div class="bumper-custom-wrap {% if talk.outro_source == 'custom' %}is-visible{% endif %}" id="outro-custom-wrap">
                      <label for="custom-outro-file" class="bumper-dropzone" id="outro-dropzone" title="Click or drag & drop custom outro clip">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                          <polyline points="17 8 12 3 7 8"/>
                          <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        <div class="bumper-dropzone-text">
                          <span class="bumper-dropzone-title">Drop video here or <u>browse</u></span>
                          <span class="bumper-file-name" id="outro-file-name">{% if talk.custom_outro_path %}{{ talk.custom_outro_path.split('/')[-1] }}{% else %}Supports MP4, WebM, MOV{% endif %}</span>
                        </div>
                      </label>
                      <input type="file" id="custom-outro-file" class="custom-bumper-file-input" accept="video/mp4,video/*">
                      <input type="hidden" id="custom-outro-path" value="{{ talk.custom_outro_path or '' }}">
                    </div>
                  </div>
                </div>

                <button class="btn btn-primary w-full btn-step-spacing" id="btn-proceed-handoff" type="button" data-edit-control="true">
                  Proceed &rarr;
                </button>
              </div>

              <!-- Step 2: Speaker Assignment & Handoff -->
              <div class="bumper-studio-card bumper-handoff-card is-hidden" id="card-speaker-handoff">
                <div class="bumper-studio-title">SPEAKER HANDOFF</div>
                <div class="bumper-group">
                  {% if talk.speaker_email %}
                    <div class="bumper-group-header">
                      <span class="bumper-group-title">Assigned Speaker</span>
                    </div>
                    <div class="assigned-speaker-display">
                      <svg class="assigned-speaker-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                      </svg>
                      <span class="assigned-speaker-email" id="assigned-speaker-email">{{ talk.speaker_email }}</span>
                    </div>
                  {% else %}
                    <div class="bumper-group-header">
                      <span class="bumper-group-title">Assign Speaker (Email)</span>
                    </div>
                    <input type="email" id="handoff-speaker-email" class="input-field handoff-email-input" placeholder="speaker@example.com" value="">
                  {% endif %}
                </div>

                <button class="btn btn-primary w-full btn-step-spacing" id="btn-approve" data-edit-control="true">
                  Handoff to Speaker
                </button>
                <button class="btn btn-ghost w-full btn-step-spacing" id="btn-back-bumpers" type="button" data-edit-control="true">
                  &larr; Back to Options
                </button>
              </div>

              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-abort" data-edit-control="true">
                Abort Talk
              </button>
            {% else %}
              <div class="badge badge-waiting badge-status-full">
                Awaiting Organizer Intro/Outro Selection
              </div>
            {% endif %}
          {% elif talk.status in ['broken', 'rejected'] %}
            <div class="badge badge-danger badge-status-full">
              {{ 'Talk Rejected' if talk.status == 'rejected' else 'Processing Failed (Broken)' }}
            </div>
            {% if is_admin_or_org %}
              <button class="btn btn-danger w-full btn-reject-spacing" id="btn-abort" data-edit-control="true">
                Abort Talk
              </button>
            {% endif %}
          {% elif talk.status == 'done' %}
            <div class="badge badge-done badge-status-full">
              <span class="badge-dot"></span> Published & Complete
            </div>

            <div class="published-download-card">
              <div class="published-download-header">
                <span class="published-download-title">Production Video</span>
                <span class="badge badge-done">READY</span>
              </div>
              <p class="published-download-desc">Master broadcast transcode is finished and published.</p>

              <a href="{{ final_asset.url if final_asset else ('/studio/media/' ~ talk.id ~ '/final/final.mp4') }}?download=true" download class="btn btn-primary w-full btn-download-master" id="btn-download-master" title="Download Master Video">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span>Download Master Video</span>
              </a>
            </div>

            {% if media_assets and media_assets | length > 1 %}
              <div class="published-other-assets">
                <div class="published-other-title">All Generated Assets</div>
                <div class="published-assets-list">
                  {% for asset in media_assets %}
                    {% if asset.category != 'final' %}
                      <div class="published-asset-row">
                        <span class="badge media-asset-badge {% if asset.category == 'intro' or asset.category == 'outro' %}badge-pending{% elif asset.category == 'raw' %}badge-waiting{% else %}badge-preview{% endif %}">
                          {{ asset.category | upper }}
                        </span>
                        <span class="published-asset-name" title="{{ asset.label }}">{{ asset.label }}</span>
                        <a href="{{ asset.url }}?download=true" download class="btn btn-ghost btn-xs btn-asset-download" title="Download {{ asset.label }}">
                          <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                          </svg>
                          <span>Download</span>
                        </a>
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        </div>

        <div id="pipeline-progress-wrap">
          <div class="pipeline-progress-header">
            <span id="pipeline-progress-status">
              <span class="spinner spinner-sm"></span> Processing Pipeline...
            </span>
            <span class="badge badge-info pipeline-pct-badge" id="pipeline-progress-pct">0%</span>
          </div>
          <div class="job-progress-track pipeline-track">
            <div id="pipeline-progress-fill" class="job-progress-fill animated"></div>
          </div>
          <div id="pipeline-progress-desc">
            Generating title slates, cutting clip & creating preview...
          </div>
        </div>
      </div>

      <div class="divider"></div>

      {% if milestones and (not user or user.role != 'speaker') %}
      {# ── Pipeline Milestones Stepper ────────────────────────── #}
      <div class="milestones-card">
        <div class="milestones-header">
          <span class="milestones-title-label">Pipeline Milestones</span>
          <span class="milestones-step-count">
            {% set completed_count = milestones | selectattr('state', 'equalto', 'completed') | list | length %}
            {{ completed_count }} of {{ milestones | length }} Complete
          </span>
        </div>
        <div class="stepper-timeline">
          {% for m in milestones %}
            <div class="stepper-step stepper-step-{{ m.state }}">
              <div class="stepper-track-col">
                <div class="stepper-node" title="{{ m.title }} ({{ m.state | replace('_', ' ') | title }})">
                  {% if m.state == 'completed' %}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  {% elif m.state == 'active' %}
                    <span class="stepper-pulse-dot"></span>
                  {% elif m.state == 'failed' %}
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"/>
                      <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  {% else %}
                    <span class="stepper-num">{{ m.num }}</span>
                  {% endif %}
                </div>
                {% if not loop.last %}
                  <div class="stepper-connector {% if m.state == 'completed' %}is-completed{% endif %}"></div>
                {% endif %}
              </div>
              <div class="stepper-info">
                <div class="stepper-heading">
                  <span class="stepper-name">{{ m.num }}. {{ m.title }}</span>
                  {% if m.state == 'completed' %}
                    <span class="badge badge-done badge-micro">Done</span>
                  {% elif m.state == 'active' %}
                    <span class="badge badge-processing badge-micro"><span class="spinner spinner-xs"></span>In Progress</span>
                  {% elif m.state == 'failed' %}
                    <span class="badge badge-danger badge-micro">Failed</span>
                  {% else %}
                    <span class="badge badge-waiting badge-micro">Pending</span>
                  {% endif %}
                </div>
                <div class="stepper-desc">{{ m.desc }}</div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </div>
  </div>

  {% if is_other_organizer_talk %}
  <!-- Admin Confirm Edit Modal -->
  <div class="modal-backdrop" id="admin-confirm-edit-modal" hidden>
    <div class="modal-dialog" role="dialog" aria-labelledby="confirm-edit-title" aria-modal="true">
      <div class="modal-header">
        <h3 class="modal-title" id="confirm-edit-title">Enable Edit Mode</h3>
        <button type="button" class="btn btn-ghost btn-sm" id="btn-modal-close-x" aria-label="Close modal">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-warning-intro">
          This talk belongs to another organizer's event: <strong>{{ talk.event.name if talk.event and talk.event.name else ('Event #' ~ talk.event_id) }}</strong>.
        </p>
        <p class="modal-warning-details">
          Enabling edit mode allows you to modify recording bounds, trigger processing, upload media, or submit review decisions that impact this event's production.
        </p>
        <p class="modal-warning-question">
          Are you sure you want to enable editing for this talk?
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost btn-sm" id="btn-modal-cancel">Cancel</button>
        <button type="button" class="btn btn-warning btn-sm" id="btn-modal-confirm">Confirm & Enable Editing</button>
      </div>
    </div>
  </div>
  {% endif %}

</div>

<!-- Abort Confirm Modal -->
<div id="modal-abort" class="modal-backdrop" hidden>
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Abort Talk</h3>
      <button class="btn btn-ghost btn-sm btn-close-modal" id="btn-close-abort-modal">✕</button>
    </div>
    <div class="modal-body">
      <p class="modal-warning-text">
        Are you sure you want to abort this talk? This will throw away the uploaded recording and clear all progress.
      </p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" id="btn-cancel-abort-modal">Cancel</button>
      <button class="btn btn-danger" id="btn-confirm-abort">Yes, Abort Talk</button>
    </div>
  </div>
</div>

<!-- Reset to Raw Confirm Modal -->
<div id="modal-reset-raw" class="modal-backdrop" hidden>
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Reset to Raw Video</h3>
      <button class="btn btn-ghost btn-sm btn-close-modal" id="btn-close-reset-raw-modal">✕</button>
    </div>
    <div class="modal-body">
      <p class="modal-warning-text">
        Are you sure you want to reset this talk to the initial raw video? All cut bounds and previews will be cleared, and you can re-trim the raw video from scratch.
      </p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" id="btn-cancel-reset-raw-modal">Cancel</button>
      <button class="btn btn-danger" id="btn-confirm-reset-raw">Reset to Raw</button>
    </div>
  </div>
</div>

{% if can_manage %}
<!-- ── MODAL: Edit Talk ────────────────────────────────────── -->
<div id="modal-edit-talk-studio" class="dashboard-modal-backdrop">
  <div class="dashboard-modal-card modal-quick-card">
    <div class="dashboard-modal-header">
      <h3 class="dashboard-modal-title">Edit Talk</h3>
      <button class="btn btn-ghost btn-sm btn-close-edit-talk dashboard-modal-close">✕</button>
    </div>
    <div class="dashboard-modal-field-sm">
      <label class="dashboard-modal-label dashboard-modal-label-tight" for="edit-talk-title">Talk Title</label>
      <input type="text" id="edit-talk-title" class="input-field" required>
    </div>
    <div class="dashboard-modal-field-sm">
      <label class="dashboard-modal-label dashboard-modal-label-tight" for="edit-talk-room">Room</label>
      <input type="text" id="edit-talk-room" class="input-field">
    </div>
    <div class="dashboard-modal-grid-2">
      <div>
        <label class="dashboard-modal-label dashboard-modal-label-tight" for="edit-talk-start">Start Time</label>
        <input type="datetime-local" id="edit-talk-start" class="input-field">
      </div>
      <div>
        <label class="dashboard-modal-label dashboard-modal-label-tight" for="edit-talk-end">End Time</label>
        <input type="datetime-local" id="edit-talk-end" class="input-field">
      </div>
    </div>
    <div class="dashboard-modal-footer">
      <button class="btn btn-ghost btn-sm btn-close-edit-talk">Cancel</button>
      <button class="btn btn-primary btn-sm" id="btn-submit-edit-talk-studio">Save Changes</button>
    </div>
  </div>
</div>
{% endif %}
{% endblock %}

{% block extra_scripts %}
<script src="/static/js/studio.js"></script>
{% endblock %}
