{% extends "base.html.jinja" %}

{% block title %}Events — VEditor{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/static/css/events.css">
{% endblock %}

{% block breadcrumb %}
  <span class="current">Events</span>
{% endblock %}

{% block content %}
<div class="page-body">

  {% if error %}
    <div class="alert alert-danger" role="alert">
      <span>{{ error }}</span>
    </div>
  {% endif %}

  <!-- Event Creation Form Card -->
  <div class="event-create-card">
    <h2 class="event-create-title">Create Event</h2>
    <p class="event-create-desc">Add a new event workspace to manage talks and video pipelines.</p>
    <form method="post" action="/studio/events" class="event-create-form">
      <div class="event-create-field">
        <label for="event-name" class="event-create-label">Event Name</label>
        <input
          type="text"
          id="event-name"
          name="name"
          class="input-field"
          placeholder="e.g. FOSSASIA Summit 2026"
          required
        >
      </div>
      <button type="submit" class="btn btn-primary" id="btn-create-event">
        Create Event
      </button>
    </form>
  </div>

  <!-- Events List Table -->
  <div class="table-wrap">
    <div class="table-header">
      <div>
        <span class="table-title">Events</span>
        <span class="table-count table-count-spaced">{{ events | length }} event{% if events | length != 1 %}s{% endif %}</span>
      </div>
    </div>

    {% if events %}
    <table>
      <thead>
        <tr>
          <th class="col-id">ID</th>
          <th>Event Name</th>
          <th>Created By / Owner</th>
          <th class="col-actions-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for event in events %}
        <tr>
          <td class="td-mono col-id">#{{ event.id }}</td>
          <td class="td-title">
            <a href="/studio?event_id={{ event.id }}" class="event-title-link">
              <strong>{{ event.name }}</strong>
            </a>
          </td>
          <td>
            {% if event.created_by_user %}
              {{ event.created_by_user.email }}
            {% elif event.created_by_user_id %}
              User #{{ event.created_by_user_id }}
            {% else %}
              <span class="text-muted">—</span>
            {% endif %}
          </td>
          <td class="col-actions-right">
            <div class="row-actions-group">
              <a href="/studio?event_id={{ event.id }}" class="btn btn-ghost btn-sm" title="Open Event">
                View Talks
              </a>
              <button type="button" class="btn btn-ghost btn-sm btn-api-keys" data-event-id="{{ event.id }}" data-event-name="{{ event.name }}" title="Manage API Keys">
                API Keys
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-edit-event" data-event-id="{{ event.id }}" data-event-name="{{ event.name }}" title="Edit Event Name">
                Edit
              </button>
              <button type="button" class="btn btn-ghost btn-sm btn-delete-event btn-danger-ghost" data-event-id="{{ event.id }}" data-event-name="{{ event.name }}" title="Delete Event">
                Delete
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="events-empty-state">
      <p class="events-empty-title">No events found</p>
      <p class="events-empty-desc">No events found. Create your first event above.</p>
    </div>
    {% endif %}
  </div>

</div>

<!-- ── MODAL: Edit Event ─────────────────────────────────────────── -->
<div id="modal-edit-event" class="events-modal-backdrop">
  <div class="events-modal-card">
    <div class="events-modal-header">
      <h3 class="events-modal-title">Edit Event Name</h3>
      <button type="button" class="btn btn-ghost btn-sm btn-close-edit-modal">✕</button>
    </div>

    <form id="edit-event-form" method="post" action="">
      <div class="events-modal-field">
        <label for="edit-event-name" class="event-create-label">Event Name</label>
        <input type="text" id="edit-event-name" name="name" class="input-field" required>
      </div>

      <div class="events-modal-footer">
        <button type="button" class="btn btn-ghost btn-sm btn-close-edit-modal">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm" id="btn-save-event">
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── MODAL: API Keys ─────────────────────────────────────────── -->
<div id="modal-api-keys" class="events-modal-backdrop">
  <div class="events-modal-card events-modal-card-lg">
    <div class="events-modal-header">
      <div>
        <h3 class="events-modal-title">API Key for <span id="api-keys-event-name-display"></span></h3>
        <p class="events-modal-desc">Manage API credentials to integrate conference schedules and video pipelines with this event.</p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm btn-close-api-keys-modal">✕</button>
    </div>

    <!-- Event Credentials Summary Box -->
    <div class="api-key-info-box">
      <div class="api-key-info-row">
        <span class="api-key-info-label">VEditor Event ID:</span>
        <code id="api-keys-event-id-display" class="api-key-code">#</code>
        <button type="button" class="btn btn-ghost btn-xs btn-copy-event-id" title="Copy Event ID">Copy ID</button>
      </div>
    </div>

    <!-- Newly Created Key Alert (Hidden by default) -->
    <div id="new-key-alert" class="alert alert-success api-key-alert-hidden">
      <div class="new-key-header">
        <strong>New API Key Generated!</strong>
        <span class="new-key-warning">Copy this key now. It will not be shown again.</span>
      </div>
      <div class="new-key-row">
        <input type="text" id="new-key-input" class="input-field input-mono" readonly>
        <button type="button" class="btn btn-primary btn-sm" id="btn-copy-new-key">Copy Key</button>
      </div>
      <div class="new-key-tip">
        <span>Copy this API key now. It is event-scoped and can be used directly in your integration settings.</span>
      </div>
    </div>

    <!-- Active Keys Section -->
    <div class="api-keys-section">
      <div class="api-keys-section-header">
        <h4 class="api-keys-subtitle">Active API Key</h4>
        <button type="button" class="btn btn-primary btn-sm" id="btn-generate-api-key">
          + Generate API Key
        </button>
      </div>

      <div id="api-keys-table-wrap">
        <table class="api-keys-table">
          <thead>
            <tr>
              <th class="col-key-id">ID</th>
              <th>Label</th>
              <th>Masked Key</th>
              <th>Created</th>
              <th>Last Used</th>
              <th class="col-actions-right">Action</th>
            </tr>
          </thead>
          <tbody id="api-keys-tbody">
            <!-- Populated dynamically via fetch -->
          </tbody>
        </table>
        <p id="api-keys-empty" class="text-muted text-center api-key-alert-hidden api-keys-empty-msg">No active API key found. Click "+ Generate API Key" above to create one.</p>
      </div>
    </div>

    <div class="events-modal-footer api-keys-modal-footer">
      <button type="button" class="btn btn-ghost btn-sm btn-close-api-keys-modal">Close</button>
    </div>
  </div>
</div>

<!-- ── MODAL: Delete Event ───────────────────────────────────────── -->
<div id="modal-delete-event" class="events-modal-backdrop">
  <div class="events-modal-card">
    <div class="events-modal-header">
      <h3 class="events-modal-title">Delete Event</h3>
      <button type="button" class="btn btn-ghost btn-sm btn-close-delete-modal">✕</button>
    </div>

    <form id="delete-event-form" method="post" action="">
      <p class="events-modal-desc">
        Are you sure you want to delete event <strong id="delete-event-name-display"></strong> and all associated talks? This action cannot be undone.
      </p>

      <div class="events-modal-footer">
        <button type="button" class="btn btn-ghost btn-sm btn-close-delete-modal">Cancel</button>
        <button type="submit" class="btn btn-danger btn-sm" id="btn-confirm-delete-event">
          Delete Event
        </button>
      </div>
    </form>
  </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script src="/static/js/events.js"></script>
{% endblock %}
