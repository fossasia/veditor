{% extends "base.html.jinja" %}

{% block title %}Sign In{% endblock %}

{% block breadcrumb %}
  <span class="current">Sign In</span>
{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/static/css/auth.css">
{% endblock %}

{% block content %}
<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <h1 class="auth-title">Sign In</h1>
      <p class="auth-subtitle">Sign in to your VEditor console account</p>
    </div>

    {% if error %}
      <div class="alert alert-danger" role="alert">
        <span>{{ error }}</span>
      </div>
    {% endif %}

    <form class="auth-form" method="post" action="/login">
      <input type="hidden" name="next" value="{{ next or '' }}">
      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input type="email" id="email" name="email" class="input-field" required autofocus value="{{ email or '' }}" placeholder="name@example.com">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="input-field" required placeholder="Enter password">
      </div>

      <button type="submit" class="btn btn-primary btn-lg btn-auth-submit">Sign In</button>
    </form>

    <div class="auth-footer">
      <span>Don't have an account? <a href="/signup">Sign up</a></span>
    </div>
  </div>
</div>
{% endblock %}
