# Example Environment Variables
# Copy this file to .env and adjust values for your local environment.

# Database Configuration
POSTGRES_USER=veditor
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veditor

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
DATA_DIR=data
STORAGE_BACKEND=local

# List of absolute directory paths that the app is allowed to ingest videos from.
# Must be a valid JSON array of strings. Empty by default for security.
INGEST_ROOTS='["/path/to/shared/mount", "/tmp/staging"]'

# Optional Settings
# ENVIRONMENT=development
# SESSION_SECRET=your_32_byte_random_secret_here
# DEBUG=True
# ENCODER_THREADS=1  # Limit encoder thread usage per video job (default: unbounded)

# Email & SMTP Configuration
# If SMTP_HOST is left empty, verification emails are logged to the console (ideal for local development).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_TLS=True
# SMTP_SSL=False
# SMTP_FROM=VEditor <noreply@veditor.org>
# SMTP_TIMEOUT_SECONDS=15
# EMAIL_VERIFICATION_EXPIRE_HOURS=24

