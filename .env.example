# Example Environment Variables
# Copy this file to .env and adjust values for your local environment.

# Database Configuration
POSTGRES_USER=veditor
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veditor

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
DATA_DIR=data
STORAGE_BACKEND=local

# List of absolute directory paths that the app is allowed to ingest videos from.
# Must be a valid JSON array of strings. Empty by default for security.
INGEST_ROOTS='["/path/to/shared/mount", "/tmp/staging"]'

# Optional Settings
# SECRET_KEY=your_super_secret_key
# DEBUG=True
